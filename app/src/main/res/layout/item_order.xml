<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCustomerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customer Name"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:textColor="#212121"/>

                <TextView
                    android:id="@+id/tvMpesaNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phone: 07XXXXXXXX"
                    android:textSize="12sp"
                    android:textColor="#BA68C8"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/tvDeliveryWay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Via: Loading..."
                    android:textSize="12sp"
                    android:textStyle="italic"
                    android:textColor="#4527A0"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/tvOrderDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24 Feb 2026, 10:00 AM"
                    android:textSize="11sp"
                    android:textColor="#9E9E9E"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAID"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="#388E3C"
                android:background="@android:drawable/editbox_dropdown_light_frame"
                android:backgroundTint="#E8F5E9"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Items Purchased:"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#616161"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/tvItemsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item details here"
            android:textColor="#424242"
            android:textSize="14sp"
            android:layout_marginTop="2dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F5F5F5"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Paid: "
                android:textSize="14sp"
                android:textColor="#757575"/>

            <TextView
                android:id="@+id/tvTotalAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ksh 0.00"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#BA68C8"/>

            <Button
                android:id="@+id/btnUpdateStatus"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:backgroundTint="#BA68C8"
                android:text="Mark Delivered"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>