<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F8F4FF">

    <TextView
        android:id="@+id/tvCashierEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/default_email"
        android:textColor="#6750A4"
        android:layout_gravity="end"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvLowStockAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFEBEE"
        android:padding="12dp"
        android:text="@string/low_stock_warning"
        android:textColor="#B71C1C"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginBottom="16dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">
        <TextView
            android:id="@+id/tvDailyTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:text="@string/daily_total_initial"
            android:textSize="18sp"
            android:textColor="#000000"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnQuickSale"
        android:layout_width="280dp"
        android:layout_height="60dp"
        android:text="@string/btn_new_sale"
        android:layout_gravity="center_horizontal"
        android:backgroundTint="#6750A4"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnViewStock"
        android:layout_width="280dp"
        android:layout_height="60dp"
        android:text="@string/btn_view_stock"
        android:layout_gravity="center_horizontal"
        android:backgroundTint="#6750A4"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnSalesHistory"
        android:layout_width="280dp"
        android:layout_height="60dp"
        android:text="@string/btn_sales_history"
        android:layout_gravity="center_horizontal"
        android:backgroundTint="#6750A4"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_logout"
        android:layout_gravity="center"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:textColor="#B71C1C"/>

</LinearLayout>